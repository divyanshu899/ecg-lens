<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>LeadLens AR Guide</title>
  <style>
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body, html {
      margin: 0; padding: 0; width: 100%; height: 100%;
      background: #000; color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      overflow: hidden;
    }
    video {
      position: fixed; top: 0; left: 0;
      width: 100vw; height: 100vh;
      object-fit: cover; z-index: 1;
    }
    canvas {
      position: fixed; top: 0; left: 0;
      width: 100vw; height: 100vh;
      z-index: 2; pointer-events: none;
    }
    #uiLayer {
      position: fixed; top: 0; left: 0;
      width: 100vw; height: 100vh;
      z-index: 10; pointer-events: none;
      display: flex; flex-direction: column;
      justify-content: space-between;
      padding: 12px;
    }
    .interactive { pointer-events: auto; }

    /* Top Bar */
    .top-panel {
      background: rgba(15, 15, 15, 0.9);
      border: 1px solid #333;
      border-radius: 12px;
      padding: 10px 14px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .row {
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .lead-title { font-size: 15px; font-weight: 700; color: #ff9800; }
    .lead-sub { font-size: 12px; color: #ccc; }
    .seg-btn {
      background: #2a2a2a; color: #aaa;
      border: 1px solid #444; border-radius: 16px;
      padding: 6px 12px; font-size: 12px; font-weight: 700;
    }
    .seg-btn.active { background: #0288d1; color: #fff; border-color: #0288d1; }
    select {
      background: #222; color: #fff; border: 1px solid #444;
      border-radius: 8px; padding: 5px 8px; font-size: 12px;
    }

    /* Bottom Controls */
    .bottom-panel {
      display: flex; flex-direction: column; gap: 10px;
      padding-bottom: 10px;
    }
    .btn-row { display: flex; gap: 10px; }
    .main-btn {
      flex: 1; background: #ff9800; color: #000;
      border: none; border-radius: 28px;
      padding: 15px; font-size: 16px; font-weight: 800;
    }
    .sec-btn {
      background: #2a2a2a; color: #fff;
      border: 1px solid #444; border-radius: 28px;
      padding: 15px 18px; font-size: 14px; font-weight: 700;
    }

    /* Chat Drawer */
    #chatBox {
      display: none;
      background: rgba(20, 20, 20, 0.96);
      border: 1px solid #444; border-radius: 16px;
      padding: 12px; max-height: 45vh;
      flex-direction: column; gap: 8px;
    }
    #chatBox.show { display: flex; }
    #chatLog {
      overflow-y: auto; max-height: 150px;
      font-size: 13px; line-height: 1.4; color: #ddd;
      display: flex; flex-direction: column; gap: 6px;
    }
    .chip-row { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; }
    .chip {
      background: #333; color: #81d4fa; border: 1px solid #555;
      border-radius: 12px; padding: 5px 10px; font-size: 11px; white-space: nowrap;
    }
  </style>
</head>
<body>

  <video id="cam" playsinline autoplay muted></video>
  <canvas id="arCanvas"></canvas>

  <div id="uiLayer">
    <!-- TOP HUD -->
    <div class="top-panel interactive">
      <div class="row">
        <div>
          <div class="lead-title" id="titleTxt">Step 1/10: Lead RA</div>
          <div class="lead-sub" id="descTxt">Right Infraclavicular Fossa</div>
        </div>
        <div style="display:flex; gap:4px;">
          <button class="seg-btn active" id="mBtn" onclick="setSex('male')">Male</button>
          <button class="seg-btn" id="fBtn" onclick="setSex('female')">Female</button>
        </div>
      </div>

      <div class="row" style="border-top:1px solid #2a2a2a; padding-top:6px;">
        <select id="bmiSel" onchange="setHabitus(this.value)">
          <option value="slim">Slim Build</option>
          <option value="std" selected>Standard Adult</option>
          <option value="heavy">High BMI / Broad</option>
        </select>
        <button class="seg-btn" id="spkBtn" onclick="speakCurrent()">🔊 Speak</button>
        <button class="seg-btn" onclick="toggleChat()">💬 Help</button>
        <span id="trackStatus" style="font-size:11px; color:#4caf50;">AR Active</span>
      </div>
    </div>

    <!-- BOTTOM CONTROLS -->
    <div class="bottom-panel interactive">
      <div id="chatBox">
        <div class="row">
          <strong style="font-size:13px; color:#81d4fa;">Clinical Assistant</strong>
          <button class="seg-btn" onclick="toggleChat()">Close ✕</button>
        </div>
        <div id="chatLog">
          <div>Tap any question below for instant clinical guidance:</div>
        </div>
        <div class="chip-row">
          <button class="chip" onclick="ask('louis')">Angle of Louis?</button>
          <button class="chip" onclick="ask('female')">Female Breast Tissue?</button>
          <button class="chip" onclick="ask('v3')">Where is V3?</button>
          <button class="chip" onclick="ask('bmi')">High BMI Tips?</button>
        </div>
      </div>

      <div class="btn-row">
        <button class="sec-btn" onclick="resetSteps()">Reset</button>
        <button class="main-btn" id="confirmBtn" onclick="nextStep()">Confirm RA</button>
      </div>
    </div>
  </div>

  <!-- Optional AI Pose Script loaded asynchronously so it NEVER blocks UI -->
  <script src="https://unpkg.com/@mediapipe/pose/pose.js" crossorigin="anonymous" async></script>

  <script>
    const LEADS = ["RA", "LA", "RL", "LL", "V1", "V2", "V4", "V3", "V5", "V6"];
    let step = 0;
    let sex = "male";
    let spread = 1.0;

    const video = document.getElementById('cam');
    const canvas = document.getElementById('arCanvas');
    const ctx = canvas.getContext('2d');

    let bodyPts = null;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    function getGuide(lead) {
      const notes = {
        "RA": "Right Infraclavicular Fossa (Below Right Clavicle)",
        "LA": "Left Infraclavicular Fossa (Below Left Clavicle)",
        "RL": "Right Lower Abdomen / Rib Margin",
        "LL": "Left Lower Abdomen / Rib Margin",
        "V1": "4th Intercostal Space, Right Sternal Border",
        "V2": "4th Intercostal Space, Left Sternal Border",
        "V4": sex === "female" ? "5th ICS beneath breast in Inframammary Fold" : "5th ICS, Mid-Clavicular Line",
        "V3": "Midway on diagonal line between V2 and V4",
        "V5": "Horizontal to V4, Anterior Axillary Line",
        "V6": "Horizontal to V4, Mid-Axillary Line"
      };
      return notes[lead] || "";
    }

    function refreshUI() {
      const title = document.getElementById('titleTxt');
      const desc = document.getElementById('descTxt');
      const btn = document.getElementById('confirmBtn');

      if (step < LEADS.length) {
        const cur = LEADS[step];
        title.innerText = "Step " + (step + 1) + "/10: Place " + cur;
        desc.innerText = getGuide(cur);
        btn.innerText = "Confirm " + cur + " ➔";
        btn.style.background = "#ff9800";
      } else {
        title.innerText = "All 10 Leads Placed!";
        desc.innerText = "12-Lead anatomical alignment complete";
        btn.innerText = "Start New Patient";
        btn.style.background = "#4caf50";
      }
    }

    function nextStep() {
      if (step < LEADS.length) {
        step++;
      } else {
        step = 0;
      }
      refreshUI();
      speakCurrent();
    }

    function resetSteps() {
      step = 0;
      refreshUI();
      speakCurrent();
    }

    function setSex(val) {
      sex = val;
      document.getElementById('mBtn').className = val === 'male' ? 'seg-btn active' : 'seg-btn';
      document.getElementById('fBtn').className = val === 'female' ? 'seg-btn active' : 'seg-btn';
      refreshUI();
    }

    function setHabitus(val) {
      if (val === 'slim') spread = 0.85;
      else if (val === 'heavy') spread = 1.25;
      else spread = 1.0;
    }

    function speakCurrent() {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const txt = step < LEADS.length
        ? "Place " + LEADS[step] + ". " + getGuide(LEADS[step])
        : "All ten leads confirmed.";
      const u = new SpeechSynthesisUtterance(txt);
      window.speechSynthesis.speak(u);
    }

    function toggleChat() {
      document.getElementById('chatBox').classList.toggle('show');
    }

    function ask(topic) {
      const log = document.getElementById('chatLog');
      let ans = "";
      if (topic === 'louis') ans = "<b>Angle of Louis:</b> Palpate the notch at the top of the sternum, slide down 4-5 cm to the bony ridge. That is the 2nd rib. Count down two spaces to the 4th ICS for V1/V2.";
      if (topic === 'female') ans = "<b>Female Placement:</b> Always lift breast tissue and place V4, V5, and V6 in the inframammary crease underneath—never over breast tissue.";
      if (topic === 'v3') ans = "<b>Lead V3:</b> Always place V2 and V4 first, then stick V3 directly halfway between them.";
      if (topic === 'bmi') ans = "<b>High BMI:</b> Palpate firmly for the sternal border and use the armpit crease to find the true mid-axillary line for V6.";

      const div = document.createElement('div');
      div.style.background = "#2a2a2a";
      div.style.padding = "8px";
      div.style.borderRadius = "8px";
      div.innerHTML = ans;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    // 1. Native Camera Startup (Works on all phones without external libraries)
    async function startNativeCamera() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false
        });
        video.srcObject = stream;
      } catch (e) {
        document.getElementById('trackStatus').innerText = "Grid Mode";
      }
    }
    startNativeCamera();

    // 2. Continuous 30 FPS AR Lead Renderer
    function drawAR() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const w = canvas.width;
      const h = canvas.height;

      let rs, ls, rh, lh;
      if (bodyPts) {
        rs = { x: bodyPts[11].x * w, y: bodyPts[11].y * h };
        ls = { x: bodyPts[12].x * w, y: bodyPts[12].y * h };
        rh = { x: bodyPts[23].x * w, y: bodyPts[23].y * h };
        lh = { x: bodyPts[24].x * w, y: bodyPts[24].y * h };
      } else {
        // Chest alignment silhouette when standing over patient
        rs = { x: w * 0.25, y: h * 0.28 };
        ls = { x: w * 0.75, y: h * 0.28 };
        rh = { x: w * 0.30, y: h * 0.74 };
        lh = { x: w * 0.70, y: h * 0.74 };
      }

      const sw = Math.hypot(ls.x - rs.x, ls.y - rs.y) || 1;
      const ux = (ls.x - rs.x) / sw;
      const uy = (ls.y - rs.y) / sw;

      const notch = { x: (rs.x + ls.x) / 2, y: (rs.y + ls.y) / 2 };
      const pelvis = { x: (rh.x + lh.x) / 2, y: (rh.y + lh.y) / 2 };

      const th = Math.hypot(pelvis.x - notch.x, pelvis.y - notch.y) || 1;
      const vx = (pelvis.x - notch.x) / th;
      const vy = (pelvis.y - notch.y) / th;

      function pt(u, v) {
        return {
          x: notch.x + ux * (u * sw) + vx * (v * th),
          y: notch.y + uy * (u * sw) + vy * (v * th)
        };
      }

      const v4V = sex === "female" ? 0.50 : 0.44;
      const v4U = (sex === "female" ? 0.30 : 0.27) * spread;

      const coords = {
        "RA": pt(-0.40, 0.08),
        "LA": pt(0.40, 0.08),
        "RL": pt(-0.26, 0.88),
        "LL": pt(0.26, 0.88),
        "V1": pt(-0.11 * spread, 0.32),
        "V2": pt(0.11 * spread, 0.32),
        "V4": pt(v4U, v4V)
      };
      coords["V3"] = {
        x: (coords["V2"].x + coords["V4"].x) / 2,
        y: (coords["V2"].y + coords["V4"].y) / 2
      };
      coords["V5"] = pt(v4U + 0.15 * spread, v4V);
      coords["V6"] = pt(v4U + 0.29 * spread, v4V);

      // Draw Sternal & Clavicular Reference Guides
      ctx.strokeStyle = "rgba(255, 255, 255, 0.22)";
      ctx.lineWidth = 2;
      ctx.setLineDash([6, 6]);
      ctx.beginPath();
      ctx.moveTo(rs.x, rs.y); ctx.lineTo(ls.x, ls.y);
      ctx.moveTo(notch.x, notch.y); ctx.lineTo(pelvis.x, pelvis.y);
      ctx.stroke();
      ctx.setLineDash([]);

      // Draw All 10 Lead Markers
      LEADS.forEach((name, idx) => {
        const p = coords[name];
        if (idx < step) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, 9, 0, Math.PI * 2);
          ctx.fillStyle = "#4caf50";
          ctx.fill();
          ctx.fillStyle = "#4caf50";
          ctx.font = "bold 13px sans-serif";
          ctx.fillText(name + " ✓", p.x + 12, p.y + 4);
        } else if (idx === step) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, 20, 0, Math.PI * 2);
          ctx.strokeStyle = "#ff9800";
          ctx.lineWidth = 3;
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(p.x, p.y, 8, 0, Math.PI * 2);
          ctx.fillStyle = "#ffeb3b";
          ctx.fill();

          ctx.fillStyle = "#ffeb3b";
          ctx.font = "bold 15px sans-serif";
          ctx.fillText("PLACE " + name, p.x + 24, p.y + 5);
        } else {
          ctx.beginPath();
          ctx.arc(p.x, p.y, 5, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(255,255,255,0.45)";
          ctx.fill();
          ctx.fillStyle = "rgba(255,255,255,0.6)";
          ctx.font = "11px sans-serif";
          ctx.fillText(name, p.x + 8, p.y + 4);
        }
      });

      requestAnimationFrame(drawAR);
    }
    requestAnimationFrame(drawAR);

    // 3. Connect AI Pose Tracking in background if network allows
    window.addEventListener('load', () => {
      if (typeof Pose !== 'undefined') {
        try {
          const pose = new Pose({
            locateFile: (file) => `https://unpkg.com/@mediapipe/pose/${file}`
          });
          pose.setOptions({ modelComplexity: 0, smoothLandmarks: true });
          pose.onResults((res) => {
            if (res.poseLandmarks) {
              bodyPts = res.poseLandmarks;
              document.getElementById('trackStatus').innerText = "AI Locked";
            }
          });
          setInterval(async () => {
            if (video.readyState >= 2) await pose.send({ image: video });
          }, 150);
        } catch (e) {}
      }
    });
  </script>
</body>
</html>
